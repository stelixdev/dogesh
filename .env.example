# Example environment variables for AFK-Bot-AI
# Copy this file to `.env` and fill in real values. DO NOT COMMIT `.env`.

# Discord Bot Token (from Discord Developer Portal)
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Groq API key
GROQ_KEY=your_groq_api_key_here
# Secondary Groq API key (used as fallback when the first is rate-limited)
GROQ_KEY_2=your_fallback_groq_api_key_here

# Tavily API key
TAVILY_KEY=your_tavily_api_key_here

# Primary Gemini API key
GEMINI_KEY=your_primary_gemini_key_here
# Additional Gemini API keys for automatic failover & cooldown support
GEMINI_API_KEY_1=your_backup_gemini_key_1
GEMINI_API_KEY_2=your_backup_gemini_key_2

